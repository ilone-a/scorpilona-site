
<div class="panorama-wrapper">
  <div id="panorama" aria-label="Suur-Merijoki 360-degree panorama"></div>
</div>

<link rel="stylesheet" href="/pannellum/build/pannellum.css" />

<script is:inline src="/pannellum/build/libpannellum.js"></script>
<script is:inline src="/pannellum/build/pannellum.js"></script>

<script is:inline>
  (() => {
    const container = document.getElementById("panorama");

    if (!container || container.dataset.initialized === "true") {
      return;
    }

    if (!window.pannellum) {
      console.error("Pannellum не загружен. Проверь файлы в /pannellum/build/.");
      return;
    }

    container.dataset.initialized = "true";

    const scenes = {
      gallery: {
        type: "equirectangular",
        panorama: "/images/suur/pano/gallery.jpg",
        title: "Gallery",
        minPitch: -30,
        maxPitch: 30,
        hotSpots: [
          {
            pitch: 0,
            yaw: 180,
            type: "scene",
            text: "Music room",
            sceneId: "musicRoom",
            targetYaw: 180,
          },
        ],
      },

      musicRoom: {
        type: "equirectangular",
        panorama: "/images/suur/pano/music-room.jpg",
        title: "Music room",
        minPitch: -30,
        maxPitch: 30,
        hotSpots: [
          {
            pitch: 0,
            yaw: 0,
            type: "scene",
            text: "Gallery",
            sceneId: "gallery",
          },
          {
            pitch: 0,
            yaw: 180,
            type: "scene",
            text: "Main hall",
            sceneId: "mainHall",
            targetYaw: 180,
          },
        ],
      },

      mainHall: {
        type: "equirectangular",
        panorama: "/images/suur/pano/main-hall.jpg",
        title: "Main hall",
        yaw: 115,
        minPitch: -30,
        maxPitch: 30,
        hotSpots: [
          {
            pitch: 0,
            yaw: -125,
            type: "scene",
            text: "Fireplace",
            sceneId: "fireplace",
          },
          {
            pitch: 0,
            yaw: 0,
            type: "scene",
            text: "Music room",
            sceneId: "musicRoom",
          },
          {
            pitch: 0,
            yaw: 317,
            type: "scene",
            text: "Boudoir",
            sceneId: "boudoir",
          },
          {
            pitch: 0,
            yaw: 65,
            type: "scene",
            text: "Library",
            sceneId: "library",
            targetYaw: 55,
          },
        ],
      },

      fireplace: {
        type: "equirectangular",
        panorama: "/images/suur/pano/fireplace.jpg",
        title: "Fireplace",
        yaw: -90,
        minPitch: -30,
        maxPitch: 30,
        hotSpots: [
          {
            pitch: 0,
            yaw: 20,
            type: "scene",
            text: "Main hall",
            sceneId: "mainHall",
            targetYaw: 75,
          },
          {
            pitch: 0,
            yaw: 0,
            type: "scene",
            text: "Boudoir",
            sceneId: "boudoir",
            targetYaw: 75,
          },
        ],
      },

      boudoir: {
        type: "equirectangular",
        panorama: "/images/suur/pano/boudoir.jpg",
        title: "Boudoir",
        minPitch: -30,
        maxPitch: 30,
        hotSpots: [
          {
            pitch: 0,
            yaw: 130,
            type: "scene",
            text: "Main hall",
            sceneId: "mainHall",
          },
        ],
      },

      library: {
        type: "equirectangular",
        panorama: "/images/suur/pano/library.jpg",
        title: "Library",
        minPitch: -30,
        maxPitch: 30,
        hotSpots: [
          {
            pitch: 0,
            yaw: -127,
            type: "scene",
            text: "Main hall",
            sceneId: "mainHall",
            targetYaw: -115,
          },
        ],
      },
    };

    try {
      window.pannellum.viewer("panorama", {
        default: {
          firstScene: "fireplace",
          sceneFadeDuration: 1000,
        },
        scenes,
      });
    } catch (error) {
      container.dataset.initialized = "false";
      console.error("Не удалось запустить панораму:", error);
    }
  })();
</script>

<style>
  .panorama-wrapper {
    width: 100%;
    margin: 20px 0;
  }

#panorama {
  width: 100%;
  height: min(85vh, 1000px);
  min-height: 400px;
  border: 1px solid #444;
  border-radius: 6px;
  overflow: hidden;
  background: #111;
}

@media (max-width: 600px) {
  #panorama {
    height: 75vh;
    min-height: 320px;
  }
}
</style>
